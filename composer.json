{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "abdulmajeed-jamaan/filament-translatable-tabs": "^4.0",
        "awobaz/compoships": "^2.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "bezhansalleh/filament-language-switch": "^4.0",
        "bezhansalleh/filament-shield": "^4.0",
        "defstudio/telegraph": "^1.59",
        "filafly/filament-phosphor-icons": "^1.0",
        "filament/filament": "^4.0",
        "filament/notifications": "^4.0",
        "filament/spatie-laravel-media-library-plugin": "^4.0",
        "flowframe/laravel-trend": "^0.4.0",
        "guava/filament-modal-relation-managers": "^2.0",
        "guzzlehttp/guzzle": "^7.8",
        "lara-zeus/spatie-translatable": "^1.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.6",
        "malzariey/filament-daterangepicker-filter": "^4.0",
        "relaticle/flowforge": "^2.0",
        "solution-forest/filament-simplelightbox": "^1.0",
        "staudenmeir/eloquent-json-relations": "^1.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "icanhazstring/composer-unused": "^0.9.4",
        "itsgoingd/clockwork": "^5.2",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "pxlrbt/filament-environment-indicator": "^3.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
