# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="HOOKAH CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://noire.od.ua
AUTO_MIGRATE=true
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ==============================================================================
# Database (MariaDB / MySQL)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=noire
DB_USERNAME=noire_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ==============================================================================
# Cache, Queue, Session & Redis
# ==============================================================================
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=14400
FILESYSTEM_DISK=local

# ==============================================================================
# Broadcasting & WebSockets (Reverb / Pusher)
# ==============================================================================
BROADCAST_DRIVER=pusher
BROADCAST_CONNECTION=reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# ==============================================================================
# Mail (SMTP)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# WebPush / VAPID Notifications
# ==============================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:"

# ==============================================================================
# AI Services
# ==============================================================================
OPENAI_API_KEY=
MISTRAL_API_KEY=

# ==============================================================================
# Firebase Cloud Messaging
# ==============================================================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID=
FCM_ALERT_SOUND=default

# ==============================================================================
# AWS S3 Storage (Optional)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
