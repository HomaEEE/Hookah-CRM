{
    {$CADDY_GLOBAL_OPTIONS}
    frankenphp
    order php_server before file_server
}

:80 {
    root * /app/public
    encode zstd gzip

    php_server {
        index index.php
    }

    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
