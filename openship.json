{
  "$schema": "https://openship.io/openship.schema.json",
  "framework": "laravel",
  "port": 80,
  "domains": [
    "noire.od.ua"
  ],
  "env": {
    "APP_NAME": "Noire",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://noire.od.ua",
    "APP_KEY": {
      "value": "",
      "secret": true
    },
    "DB_CONNECTION": "mysql",
    "DB_HOST": "mariadb",
    "DB_PORT": "3306",
    "DB_DATABASE": "noire",
    "DB_USERNAME": "noire",
    "DB_PASSWORD": {
      "value": "",
      "secret": true
    },
    "DB_ROOT_PASSWORD": {
      "value": "",
      "secret": true
    },
    "REDIS_CLIENT": "phpredis",
    "REDIS_HOST": "redis",
    "REDIS_PORT": "6379",
    "REDIS_PASSWORD": {
      "value": "",
      "secret": true
    },
    "CACHE_STORE": "redis",
    "SESSION_DRIVER": "redis",
    "QUEUE_CONNECTION": "redis",
    "SERVER_NAME": ":80",
    "FRANKENPHP_CONFIG": "worker ./public/frankenphp-worker.php",
    "INFRA_NETWORK": "openship-mariadb",
    "APP_SLUG": "noire"
  }
}
